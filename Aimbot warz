-- 2. AUTO HEAL SYSTEM
-- ======================================================================
local remoteCache = nil
local function getUseItemRemote()
    if remoteCache and remoteCache.Parent then return remoteCache end
    remoteCache = nil
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local r = remotes and remotes:FindFirstChild("UseItem")
    if not r then
        for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
            if d.Name == "UseItem" and (d:IsA("RemoteEvent") or d:IsA("RemoteFunction")) then
                r = d
                break
            end
        end
    end
    remoteCache = r
    return r
end

local lastHealTime = 0
task.spawn(function()
    while _G.P7DRunId == runId do
        if Settings.AutoHealEnabled then
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 and (hum.Health / hum.MaxHealth) <= Settings.HealThreshold then
                if (os.clock() - lastHealTime) >= 0.5 then
                    lastHealTime = os.clock()
                    local remote = getUseItemRemote()
                    if remote then
                        pcall(function()
                            if remote:IsA("RemoteFunction") then
                                remote:InvokeServer(3, Settings.ItemName, nil, nil, true)
                            else
                                remote:FireServer(3, Settings.ItemName, nil, nil, true)
                            end
                        end)
                    end
                end
            end
        end
        task.wait(0.3)
    end
end)

